{
  "name": "xeque-palavras",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "overrides": { "esbuild": "0.28.2" },
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "dev:cloud": "wrangler dev --config wrangler.jsonc --local --ip 127.0.0.1 --port 8787",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:cloud": "node scripts/test-cloud.mjs",
    "words:build": "node scripts/build-dictionaries.mjs",
    "android:assets": "node scripts/prepare-android-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.2",
    "miniflare": "^5.20261001.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
